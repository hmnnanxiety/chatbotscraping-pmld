# Copy this file to .env and fill in real values from a logged-in
# browser session (DevTools > Application > Cookies for idmc.jogjaprov.go.id).
# NEVER commit the real .env file — it's already in .gitignore.

# Optional — only needed if/when the LLM function-calling layer (app.py) is wired in
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxx"

# Fallback session cookies used if the portal doesn't set them automatically.
# Get these by logging into https://idmc.jogjaprov.go.id/, opening
# DevTools > Application > Cookies, and copying the current values.
DWH_COOKIE_APP_SESSION="paste-app-session-cookie-value-here"
DWH_COOKIE_LARAVEL_SESSION="paste-laravel-session-cookie-value-here"
DWH_COOKIE_XSRF_EXTRA="paste-extra-xsrf-cookie-value-here"
DWH_COOKIE_XSRF_TOKEN="paste-xsrf-token-cookie-value-here"
